<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release defaults to encrypted traffic. Protocol-specific components may opt into
         cleartext only where the protocol genuinely requires it. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Developer-installed CAs are available only to debug builds. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
