<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Jellyfin LAN HTTP is opt-in and is enforced by JellyfinClient. Android's network
         security config cannot be changed dynamically for a user-selected private host. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Developer-installed CAs are available only to debug builds. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
