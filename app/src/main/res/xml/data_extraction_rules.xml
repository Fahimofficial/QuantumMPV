<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.
  Secure-folder media is never uploaded to cloud backup; regenerable thumbnails are skipped everywhere.
  Saved secrets are encrypted with a Keystore key that is not backed up, so restored copies cannot be
  decrypted and the app asks the user to sign in again.
-->
<data-extraction-rules>
    <!-- Secure Folder media and its PIN state never leave the device: the media is encrypted with a
         device-bound key that does not transfer, so a copy would be unreadable anyway. -->
    <cloud-backup>
        <exclude domain="file" path="secure_media/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="sharedpref" path="secure_folder.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure_media/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="sharedpref" path="secure_folder.xml" />
    </device-transfer>
</data-extraction-rules>
