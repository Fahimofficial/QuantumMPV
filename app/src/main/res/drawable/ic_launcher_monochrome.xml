<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-colour QuantumMPV mark (ring + play triangle + accent dot) used for the Android 13+
  themed launcher icon and the media notification small icon. It mirrors the full-colour logo
  without the thin outer arcs, which disappear at status-bar sizes. Everything sits inside the
  66dp adaptive-icon safe zone (21..87 on the 108 viewport).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring: outer r=22, inner r=13, cut with even-odd fill. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,32 A22,22 0 1,1 53.99,32 Z M54,41 A13,13 0 1,0 54.01,41 Z" />
    <!-- Play triangle centred in the ring. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,46.5 L62,54 L50,61.5 Z" />
    <!-- Accent dot, separated from the ring by a clear gap. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M75,70 A5,5 0 1,1 74.99,70 Z" />
</vector>
