<?xml version="1.0" encoding="utf-8"?>
<!--
  Two pause bars morphing into the play triangle (M 8 5 L 19 12 L 8 19 Z).
  See avd_play_to_pause.xml for why the triangle is written as two point-matched quads.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="pause_play"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="glyph"
                android:fillColor="#FFFFFFFF"
                android:pathData="M 6 5 L 10 5 L 10 19 L 6 19 Z M 14 5 L 18 5 L 18 19 L 14 19 Z" />
        </vector>
    </aapt:attr>
    <target android:name="glyph">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="pathData"
                android:valueFrom="M 6 5 L 10 5 L 10 19 L 6 19 Z M 14 5 L 18 5 L 18 19 L 14 19 Z"
                android:valueTo="M 8 5 L 13.5 8.5 L 13.5 15.5 L 8 19 Z M 13.5 8.5 L 19 12 L 19 12 L 13.5 15.5 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
</animated-vector>
