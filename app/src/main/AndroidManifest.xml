<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Existing manifest content retained; the MediaTransferReceiver is intentionally exported
         because AndroidX MediaRouter delivers system/media-transfer broadcasts to it. -->

    <!-- PATCH: microphone permission is optional hardware. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- PATCH: correct Android 15+ promoted-notification permission spelling. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

</manifest>
