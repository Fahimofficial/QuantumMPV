---
import {
  ArrowRight,
  BookOpen,
  Code2,
  Download,
  Gauge,
  Layers3,
  Music2,
  Play,
  ShieldCheck,
  Subtitles,
  Wifi,
} from "@lucide/astro";

const releaseUrl = "https://github.com/Riteshp2001/mpvRx/releases/latest";

const capabilities = [
  {
    icon: Gauge,
    title: "A playback engine you can tune",
    body: "libmpv at the core, with hardware decoding, frame stepping, A-B loops, speed controls, refresh-rate matching, and a live diagnostics page.",
  },
  {
    icon: Layers3,
    title: "HDR and shaders, under control",
    body: "HDR-toys pipelines, Anime4K tiers, GPU debanding, ambient modes, and thermal-aware safeguards for demanding devices.",
  },
  {
    icon: Subtitles,
    title: "Subtitles without compromise",
    body: "Dual tracks, deep styling, online search, TMDB episode selection, font management, and speech-to-subtitle workflows.",
  },
  {
    icon: Wifi,
    title: "Local, network, and online media",
    body: "Browse device storage, SMB, FTP, SFTP, WebDAV, Jellyfin, Navidrome, direct streams, playlists, and torrents from one app.",
  },
  {
    icon: Music2,
    title: "A real music mode",
    body: "Songs, albums, artists, playlists, lyrics, favorites, artwork, an up-next queue, and four audio visualizers.",
  },
  {
    icon: Code2,
    title: "Your player, scriptable",
    body: "Edit mpv.conf, input.conf, Lua, and JavaScript in-app. Add custom controls and call native mpvRx actions through a documented bridge.",
  },
];

const builds = [
  ["Standard", "Recommended", "Full Vulkan-capable release with per-ABI and universal APKs."],
  ["No Vulkan", "Compatibility", "Universal build for devices or drivers that work better without Vulkan."],
  ["FongMi", "Alternate native", "Universal build with the alternate MediaCodec and Vulkan integration."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="mpvRx is a focused Android media player powered by mpv, with expressive controls, advanced rendering, libraries, streaming, and scripting."
    />
    <meta name="theme-color" content="#111314" />
    <meta property="og:title" content="mpvRx - Android media, without the noise" />
    <meta property="og:description" content="Serious playback, expressive controls, and your media on your terms." />
    <meta property="og:image" content="/images/player.png" />
    <title>mpvRx | Android media, without the noise</title>
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="mpvRx home">
        <img src="/images/icon.png" alt="" width="42" height="42" />
        <span>mpvRx</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#experience">Experience</a>
        <a href="#builds">Builds</a>
        <a href="/docs">Docs</a>
        <a class="icon-link" href="https://github.com/Riteshp2001/mpvRx" aria-label="mpvRx on GitHub">
          <Code2 size={20} strokeWidth={1.8} />
        </a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-media" src="/images/player.png" alt="mpvRx player controls over a landscape video" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> Open source · Android 8.0+</p>
          <h1 id="hero-title">mpvRx</h1>
          <p class="hero-lede">Android media,<br />without the noise.</p>
          <p class="hero-copy">
            The precision of mpv with an interface built for touch. No ads. No trackers. Deep controls when you want them.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={releaseUrl}>
              <Download size={19} strokeWidth={2} />
              Download latest
            </a>
            <a class="button button-secondary" href="/docs">
              <BookOpen size={19} strokeWidth={2} />
              Read the docs
            </a>
          </div>
        </div>
        <a class="hero-cue" href="#experience">
          Explore the player <ArrowRight size={17} />
        </a>
      </section>

      <section class="signal-strip" aria-label="mpvRx highlights">
        <div><strong>77</strong><span>bundled HDR shaders</span></div>
        <div><strong>3</strong><span>native build variants</span></div>
        <div><strong>4</strong><span>network protocols</span></div>
        <div><strong>2</strong><span>scripting languages</span></div>
      </section>

      <section class="experience section" id="experience">
        <div class="section-heading">
          <p class="eyebrow dark"><span></span> The playback surface</p>
          <h2>Power where it matters.<br />Quiet everywhere else.</h2>
          <p>
            mpvRx keeps the video central and lets controls, diagnostics, and processing depth appear only when you ask for them.
          </p>
        </div>
        <div class="feature-grid">
          {capabilities.map(({ icon: Icon, title, body }, index) => (
            <article class="feature" style={`--index:${index}`}>
              <Icon size={24} strokeWidth={1.7} />
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="showcase section" aria-labelledby="showcase-title">
        <div class="section-heading compact">
          <p class="eyebrow"><span></span> Built for the whole library</p>
          <h2 id="showcase-title">From a folder to the final frame.</h2>
        </div>
        <div class="showcase-grid">
          <figure class="phone-shot">
            <img src="/images/folderscreen.png" alt="mpvRx folder browser" loading="lazy" />
            <figcaption>Scan, pin, sort, and move through local or network folders.</figcaption>
          </figure>
          <div class="landscape-stack">
            <figure>
              <img src="/images/playlist-grid.png" alt="mpvRx visual playback queue" loading="lazy" />
              <figcaption>A visual queue that stays close to playback.</figcaption>
            </figure>
            <figure>
              <img src="/images/frame-navigation.png" alt="mpvRx frame navigation controls" loading="lazy" />
              <figcaption>Frame-level navigation for the moments that need precision.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="principles section">
        <div class="principle-copy">
          <ShieldCheck size={30} strokeWidth={1.6} />
          <p class="eyebrow dark">Built in the open</p>
          <h2>Your files are not the product.</h2>
          <p>
            mpvRx is AGPL-licensed and publishes its source, release history, and build variants on GitHub. It does not ship ads or analytics trackers.
          </p>
          <a class="text-link" href="/docs/reference/privacy-and-permissions">
            Read the privacy and permissions guide <ArrowRight size={17} />
          </a>
        </div>
        <div class="principle-list">
          <div><span>01</span><p><strong>Local first</strong>Your device library remains the default path.</p></div>
          <div><span>02</span><p><strong>Explicit connections</strong>You choose the servers and services to connect.</p></div>
          <div><span>03</span><p><strong>Inspect the source</strong>Behavior and release artifacts remain public.</p></div>
        </div>
      </section>

      <section class="builds section" id="builds">
        <div class="section-heading compact">
          <p class="eyebrow dark"><span></span> Choose deliberately</p>
          <h2>One player. Three native builds.</h2>
          <p>Start with Standard. Switch only when your hardware or playback pipeline benefits from a different native stack.</p>
        </div>
        <div class="build-grid">
          {builds.map(([name, badge, description], index) => (
            <article class:list={["build", { recommended: index === 0 }]}>
              <div><span class="build-index">0{index + 1}</span><span class="build-badge">{badge}</span></div>
              <h3>{name}</h3>
              <p>{description}</p>
              <a href="/docs/getting-started/build-variants">Compare builds <ArrowRight size={16} /></a>
            </article>
          ))}
        </div>
      </section>

      <section class="final-cta">
        <img src="/images/chapters.png" alt="mpvRx chapter navigation" loading="lazy" />
        <div class="final-shade"></div>
        <div class="final-content">
          <Play size={34} fill="currentColor" />
          <h2>Make playback yours.</h2>
          <p>Install the latest release, then use the docs to tune only what your device and library need.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={releaseUrl}><Download size={19} /> Download</a>
            <a class="button button-secondary" href="/docs/getting-started/first-playback"><BookOpen size={19} /> Start here</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="/"><img src="/images/icon.png" alt="" width="36" height="36" /><span>mpvRx</span></a>
      <p>Built on mpv. Open source under AGPL-3.0-or-later.</p>
      <div><a href="/docs">Docs</a><a href="https://github.com/Riteshp2001/mpvRx/issues">Support</a><a href="https://github.com/Riteshp2001/mpvRx">Source</a></div>
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: "IBM Plex Sans", sans-serif; background: #111314; color: #f4f5ef; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: #111314; color: #f4f5ef; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .site-header { position: absolute; z-index: 10; top: 0; left: 0; width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 18px clamp(20px, 4vw, 68px); border-bottom: 1px solid rgba(255,255,255,.16); background: rgba(17,19,20,.66); backdrop-filter: blur(18px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 700 1.1rem "Space Grotesk", sans-serif; }
  .brand img { border-radius: 8px; }
  nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 38px); font-weight: 600; font-size: .92rem; }
  nav a { color: #e7e9e4; }
  nav a:hover, footer a:hover { color: #66d9cc; }
  .icon-link { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid rgba(255,255,255,.26); border-radius: 50%; }
  .hero { position: relative; min-height: min(820px, 88vh); overflow: hidden; display: flex; align-items: flex-end; padding: 120px clamp(22px, 7vw, 110px) 96px; border-bottom: 1px solid #303538; }
  .hero-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-shade { position: absolute; inset: 0; background: rgba(7,9,10,.68); }
  .hero-content { position: relative; width: min(710px, 100%); z-index: 1; animation: reveal .7s ease-out both; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; color: #c8d0cc; text-transform: uppercase; font-size: .76rem; font-weight: 700; }
  .eyebrow span { width: 28px; height: 2px; background: #66d9cc; }
  .eyebrow.dark { color: #58615e; }
  h1, h2, h3 { margin: 0; font-family: "Space Grotesk", sans-serif; letter-spacing: 0; }
  h1 { font-size: clamp(4.5rem, 13vw, 10rem); line-height: .82; }
  .hero-lede { margin: 28px 0 16px; font: 600 clamp(2rem, 4vw, 4rem)/1.02 "Space Grotesk", sans-serif; }
  .hero-copy { max-width: 620px; margin: 0; color: #d0d5d2; font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .button { min-height: 48px; display: inline-flex; align-items: center; gap: 10px; padding: 0 20px; border: 1px solid rgba(255,255,255,.28); border-radius: 6px; font-weight: 700; }
  .button-primary { border-color: #f16445; background: #f16445; color: #111314; }
  .button-secondary { background: rgba(17,19,20,.64); color: #fff; backdrop-filter: blur(10px); }
  .button:hover { transform: translateY(-2px); }
  .hero-cue { position: absolute; z-index: 2; right: clamp(22px, 5vw, 72px); bottom: 30px; display: flex; align-items: center; gap: 8px; color: #d8ddda; font-size: .9rem; }
  .signal-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid #303538; background: #171a1b; }
  .signal-strip div { min-height: 112px; padding: 24px clamp(18px, 3vw, 42px); border-right: 1px solid #303538; display: flex; flex-direction: column; justify-content: center; }
  .signal-strip div:last-child { border-right: 0; }
  .signal-strip strong { color: #66d9cc; font: 700 2rem "Space Grotesk", sans-serif; }
  .signal-strip span { color: #aeb5b2; font-size: .84rem; }
  .section { padding: clamp(72px, 9vw, 128px) clamp(22px, 7vw, 110px); }
  .experience { color: #171a1b; background-color: #f1f2ec; background-image: radial-gradient(#c8cfca 1px, transparent 1px); background-size: 22px 22px; }
  .section-heading { display: grid; grid-template-columns: 1.2fr .8fr; column-gap: 8vw; align-items: end; margin-bottom: 58px; }
  .section-heading .eyebrow { grid-column: 1 / -1; }
  .section-heading h2 { font-size: clamp(2.4rem, 5vw, 5.2rem); line-height: 1; }
  .section-heading > p:last-child { max-width: 560px; margin: 0; color: #58615e; font-size: 1.05rem; line-height: 1.65; }
  .section-heading.compact { display: block; max-width: 900px; }
  .section-heading.compact p:last-child { margin-top: 22px; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #c7cdca; border-left: 1px solid #c7cdca; }
  .feature { min-height: 260px; padding: 30px; border-right: 1px solid #c7cdca; border-bottom: 1px solid #c7cdca; background: rgba(241,242,236,.88); animation: reveal .55s ease-out both; animation-delay: calc(var(--index) * 70ms); }
  .feature svg { color: #087f75; }
  .feature h3 { margin-top: 42px; font-size: 1.25rem; }
  .feature p { margin: 12px 0 0; color: #58615e; line-height: 1.55; }
  .showcase { background: #111314; }
  .showcase .section-heading h2 { color: #f4f5ef; }
  .showcase-grid { display: grid; grid-template-columns: minmax(240px, .42fr) 1fr; gap: clamp(28px, 5vw, 70px); align-items: center; }
  figure { margin: 0; }
  figure img { width: 100%; border: 1px solid #343a3c; border-radius: 8px; background: #090a0b; }
  figcaption { margin-top: 13px; color: #9fa7a3; font-size: .9rem; }
  .phone-shot { max-width: 360px; justify-self: center; }
  .landscape-stack { display: grid; gap: 32px; }
  .principles { display: grid; grid-template-columns: .95fr 1.05fr; gap: 9vw; background: #66d9cc; color: #111314; }
  .principle-copy > svg { margin-bottom: 34px; }
  .principle-copy h2 { font-size: clamp(2.5rem, 5vw, 5rem); line-height: 1; }
  .principle-copy > p:not(.eyebrow) { max-width: 620px; font-size: 1.08rem; line-height: 1.65; }
  .text-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; border-bottom: 1px solid currentColor; font-weight: 700; }
  .principle-list { border-top: 1px solid rgba(17,19,20,.35); }
  .principle-list > div { display: grid; grid-template-columns: 50px 1fr; gap: 22px; padding: 28px 0; border-bottom: 1px solid rgba(17,19,20,.35); }
  .principle-list span { font-family: "Space Grotesk", sans-serif; color: #315b57; }
  .principle-list p { margin: 0; color: #31514e; }
  .principle-list strong { display: block; margin-bottom: 5px; color: #111314; font: 600 1.16rem "Space Grotesk", sans-serif; }
  .builds { color: #171a1b; background: #f1f2ec; }
  .build-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .build { min-height: 260px; padding: 28px; border: 1px solid #c7cdca; border-radius: 8px; background: #f8f8f4; }
  .build.recommended { border-top: 4px solid #f16445; }
  .build > div { display: flex; justify-content: space-between; align-items: center; }
  .build-index { color: #78817d; font-family: "Space Grotesk", sans-serif; }
  .build-badge { padding: 5px 8px; border: 1px solid #c7cdca; border-radius: 4px; color: #58615e; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .build h3 { margin-top: 48px; font-size: 1.45rem; }
  .build p { min-height: 72px; color: #58615e; line-height: 1.55; }
  .build a { display: inline-flex; align-items: center; gap: 7px; color: #087f75; font-weight: 700; }
  .final-cta { position: relative; min-height: 500px; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 70px 22px; text-align: center; }
  .final-cta > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .final-shade { position: absolute; inset: 0; background: rgba(7,9,10,.78); }
  .final-content { position: relative; z-index: 1; max-width: 700px; }
  .final-content > svg { color: #f16445; }
  .final-content h2 { margin-top: 20px; font-size: clamp(2.6rem, 6vw, 5.4rem); }
  .final-content p { color: #c4cbc7; font-size: 1.08rem; line-height: 1.6; }
  .final-content .hero-actions { justify-content: center; }
  footer { min-height: 130px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; padding: 28px clamp(22px, 5vw, 72px); border-top: 1px solid #303538; color: #9fa7a3; }
  footer > p { margin: 0; text-align: center; font-size: .85rem; }
  footer > div { display: flex; justify-content: flex-end; gap: 22px; font-size: .88rem; }
  @keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }
  @media (max-width: 820px) {
    .site-header nav a:not(.icon-link):not(:last-of-type) { display: none; }
    .hero { min-height: 84vh; padding-bottom: 82px; }
    .hero-media { object-position: 58% center; }
    .hero-cue { left: 22px; right: auto; }
    .signal-strip { grid-template-columns: repeat(2, 1fr); }
    .signal-strip div:nth-child(2) { border-right: 0; }
    .signal-strip div:nth-child(-n+2) { border-bottom: 1px solid #303538; }
    .section-heading, .principles { grid-template-columns: 1fr; gap: 34px; }
    .section-heading > p:last-child { margin-top: 22px; }
    .feature-grid, .build-grid { grid-template-columns: 1fr; }
    .showcase-grid { grid-template-columns: 1fr; }
    .phone-shot { max-width: 290px; }
    footer { grid-template-columns: 1fr; justify-items: start; }
    footer > p { text-align: left; }
    footer > div { justify-content: flex-start; flex-wrap: wrap; }
  }
  @media (max-width: 480px) {
    .site-header { padding: 14px 16px; }
    .site-header nav { gap: 12px; }
    .hero { min-height: 760px; padding-left: 18px; padding-right: 18px; }
    .hero-actions { display: grid; }
    .button { justify-content: center; }
    .section { padding-left: 18px; padding-right: 18px; }
    .signal-strip div { min-height: 96px; }
  }
</style>
