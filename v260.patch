+      trackNumber = obj["track"]?.jsonPrimitive?.intOrNull,
+      discNumber = obj["discNumber"]?.jsonPrimitive?.intOrNull,
+      year = obj["year"]?.jsonPrimitive?.intOrNull,
+      genre = obj["genre"]?.jsonPrimitive?.content,
