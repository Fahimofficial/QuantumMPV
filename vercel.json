{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</favicon.svg>; rel=\"icon\"; type=\"image/svg+xml\", </favicon.png>; rel=\"alternate icon\"; type=\"image/png\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/website/public/images/:path*"
    }
  ]
}
