From eb237b3e4ea4cedb251e51b9bb05c3dedf0dceef Mon Sep 17 00:00:00 2001
From: Arnab Sadhukhan <arnab@Arnabs-Mac-Mini.local>
Date: Mon, 14 Sep 2026 20:08:32 +0530
Subject: [PATCH 092/140] fix(visualizer): eliminate frozen spectrum spike on
 blob visualizer when paused

---
 app/src/main/assets/shaders/visualizer/blob/blob_vertex.glsl  | 2 +-
 .../com/quantummpv/app/ui/player/visualizer/BlobRenderer.kt    | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/app/src/main/assets/shaders/visualizer/blob/blob_vertex.glsl b/app/src/main/assets/shaders/visualizer/blob/blob_vertex.glsl
index e5914a0e..af4dbfc9 100644
--- a/app/src/main/assets/shaders/visualizer/blob/blob_vertex.glsl
+++ b/app/src/main/assets/shaders/visualizer/blob/blob_vertex.glsl
@@ -94,7 +94,7 @@ void main() {
     float detailNoise = snoise(aPosition * (4.2 + uTreble * 2.2) - vec3(uTime * 0.38));
     float breathing = 0.016 * sin(uTime * 1.1 + aPosition.y * 3.2);
 
-    float specDisplacement = specValue * 0.22 * (1.0 + uBass * 0.7);
+    float specDisplacement = specValue * 0.22 * uAudio * (1.0 + uBass * 0.7);
     float shockwave = sin(length(aPosition) * 5.0 - uTime * 6.0) * (uBeat * 0.08 + uFlux * 0.05);
 
     float reaction = 0.025 + uAudio * 0.52 + uBass * 0.26 + uSubBass * 0.18 + uBeat * 0.16;
diff --git a/app/src/main/java/com/quantummpv/app/ui/player/visualizer/BlobRenderer.kt b/app/src/main/java/com/quantummpv/app/ui/player/visualizer/BlobRenderer.kt
index c39809fd..ea508766 100644
--- a/app/src/main/java/com/quantummpv/app/ui/player/visualizer/BlobRenderer.kt
+++ b/app/src/main/java/com/quantummpv/app/ui/player/visualizer/BlobRenderer.kt
@@ -404,9 +404,11 @@ internal class BlobRenderer(
     volumeScale: Float,
   ) {
     spectrumUploadBuffer.clear()
+    val active = sourceAudio.active
+    val scale = if (active) volumeScale else 0f
     val populatedBins = min(spectrum.size, 512)
     for (index in 0 until populatedBins) {
-      spectrumUploadBuffer.put(spectrum[index] * volumeScale)
+      spectrumUploadBuffer.put(spectrum[index] * scale)
     }
     for (index in populatedBins until 512) {
       spectrumUploadBuffer.put(0f)
-- 
2.25.1

