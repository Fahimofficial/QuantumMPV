+        onDoubleTap = { position ->
+          when {
+            position.x < size.width / 3f -> viewModel.handleLeftDoubleTap()
+            position.x > size.width * 2f / 3f -> viewModel.handleRightDoubleTap()
+            else -> viewModel.handleCenterDoubleTap()
+          }
+        },
+      )
+    }
