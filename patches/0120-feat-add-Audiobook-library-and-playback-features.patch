+}
+
+@Composable
+private fun AudiobookEditDialog(book: AudiobookEntity, onDismiss: () -> Unit, onSave: (AudiobookEntity) -> Unit) {
+  var title by rememberSaveable(book.id) { mutableStateOf(book.title) }
