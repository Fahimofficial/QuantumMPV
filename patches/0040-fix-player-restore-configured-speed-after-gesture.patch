 import kotlin.math.min
 import kotlin.math.roundToInt
diff --git a/app/src/main/java/com/quantummpv/app/ui/browser/components/FloatingBottomBar.kt b/app/src/main/java/com/quantummpv/app/ui/browser/components/FloatingBottomBar.kt
index 3bf58406..1351e03c 100644
--- a/app/src/main/java/com/quantummpv/app/ui/browser/components/FloatingBottomBar.kt
+++ b/app/src/main/java/com/quantummpv/app/ui/browser/components/FloatingBottomBar.kt
@@ -22,6 +22,7 @@ import androidx.compose.foundation.layout.padding
 import androidx.compose.foundation.layout.size
 import androidx.compose.foundation.layout.systemBars
 import androidx.compose.foundation.layout.windowInsetsPadding
+import androidx.compose.foundation.shape.CircleShape
 import androidx.compose.foundation.shape.RoundedCornerShape
 import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
 import androidx.compose.material3.IconButton
diff --git a/app/src/main/java/com/quantummpv/app/ui/player/controls/GestureHandler.kt b/app/src/main/java/com/quantummpv/app/ui/player/controls/GestureHandler.kt
