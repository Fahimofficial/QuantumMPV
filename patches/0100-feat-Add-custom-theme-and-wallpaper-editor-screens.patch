+@Composable
+private fun WallpaperSlider(
+  label: String,
+  value: Float,
+  valueRange: ClosedFloatingPointRange<Float>,
+  onValueChange: (Float) -> Unit,
+) {
+  Column {
+    Text(label, style = MaterialTheme.typography.labelLarge)
+    Slider(
+      value = value,
+      onValueChange = onValueChange,
+      valueRange = valueRange,
+    )
+  }
+}
