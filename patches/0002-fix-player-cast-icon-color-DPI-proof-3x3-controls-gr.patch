 .../mpvrx/ui/player/controls/PlayerControlDrawer.kt      | 9 ++++++++-
 .../mpvrx/ui/player/controls/PlayerControlsShared.kt     | 1 +
 .../controls/components/sheets/AspectRatioSheet.kt       | 4 ++--
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/quantummpv/app/ui/cast/CastPlayerButton.kt b/app/src/main/java/com/quantummpv/app/ui/cast/CastPlayerButton.kt
index aa3c2135..af04b53b 100644
