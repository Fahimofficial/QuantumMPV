+    val input = currentAutoCropInput()
+    if (input.width <= 0 || input.height <= 0 || autoCropAnalyzedInput == input) return
+    cancelAutoCropAnalysis()
+    clearAutoCropProperty()
+    scheduleAutoCropAnalysis(force = true)
+  }
