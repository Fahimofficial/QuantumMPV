+          item {
+            SharedMusicCarouselSection(
+              title = "Albums (${artist.albums.size})",
+              items = artist.albums,
+              getId = { it.id },
+              getTitle = { it.title },
+              getSubtitle = { it.year?.toString() ?: "" },
+              getArtworkUrl = { navidromeRepository.getCoverArtUrl(server, it.coverArtId) },
+              onClick = { viewModel.openAlbumDetail(it) },
+              cardWidth = 140.dp,
+            )
+          }
+        }
+      }
+    }
+  }
